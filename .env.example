# Copy to .env and fill what you need. Everything here is optional for local use.
# Run with:  node --env-file=.env server.js     (Node 20.6+)   or   docker compose --env-file .env up

PORT=3000
HOST=127.0.0.1            # 0.0.0.0 only inside Docker / a trusted network, and then ALWAYS set APP_PASSWORD

# Protect the whole app with a login prompt (strongly recommended whenever HOST is not 127.0.0.1)
APP_USER=admin
APP_PASSWORD=

# AI keys (or paste them in the app's Settings instead)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
OLLAMA_API_KEY=         # from https://ollama.com/settings/keys

RATE_LIMIT_PER_MIN=600

# Optional: send AI calls through a proxy / gateway
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# HF_BASE_URL=
# OLLAMA_BASE_URL=   # default: https://ollama.com with a key, http://127.0.0.1:11434 without one
